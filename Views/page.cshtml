@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "master.cshtml";

    var currentPage = Umbraco.AssignedContentItem;

    // Filtra diretamente os filhos do tipo "block"
    var Blocks = currentPage
                    .Children()
                    .Where(x => x.IsDocumentType("block"))
                    .ToList(); // Se não houver, ToList() já retorna lista vazia
}

<section class="woosh-intro">
    <div class="shape-image-animation bottom-0 p-0 w-100 d-none d-md-block">
        <svg xmlns="http://www.w3.org/2000/svg" widht="3000" height="400" viewBox="0 180 2500 200" fill="#ffffff">
            <path class="st1" d="M 0 250 C 1200 400 1200 50 3000 250 L 3000 550 L 0 550 L 0 250">
                <animate attributeName="d" dur="5s" values="M 0 250 C 1200 400 1200 50 3000 250 L 3000 550 L 0 550 L 0 250;
                    M 0 250 C 400 50 400 400 3000 250 L 3000 550 L 0 550 L 0 250;
                    M 0 250 C 1200 400 1200 50 3000 250 L 3000 550 L 0 550 L 0 250" repeatCount="indefinite"></animate>
            </path>
        </svg>
    </div>
</section>

@foreach (var bloco in Blocks)
{
    string content = bloco.Value<string>("content"); // Rich Text Editor
    var partialName = $"Partials/Blocks/{bloco.Name}";

    try
    {
        // Tenta renderizar o partial, mesmo que parameter seja null
        @await Html.PartialAsync(partialName, bloco)
    }
    catch
    {
        // Se o partial não existir, renderiza Rich Text Editor
        if (!string.IsNullOrEmpty(content))
        {
            <div class="block-content">
                @Html.Raw(content)
            </div>
        }
    }

    @await Html.GetBlockGridHtmlAsync(bloco, "blockGrids");

}

<div class="woosh-app-footer">
    <div class="container pt-2 pb-2">
    <div class="row">
        <div class="col-6">
            <span class="text-black">Faça o download do App Woosh e descubra ainda mais vantagens de ser um parceiro Woosh</span>
        </div>
        <div class="col-2">
            <img src="/images/icons/AppStore.svg" alt="Apple Store Woosh App"/>
        </div>
        <div class="col-2">
            <img src="/images/icons/googlePlay.svg" alt="Google Play Woosh App" />
        </div>
    </div>
    </div>
</div>

<style>
    .woosh-intro {
        position: relative;
        padding-top: 413px !important;
        padding-bottom: 150px !important;
        margin-bottom: 16px;
        background: linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)), url(/images/DSCF5864.jpg) center/cover no-repeat;
    }


        .woosh-intro .container {
            backdrop-filter: blur(23px);
            padding: 72px 50px;
            border-radius: 20px;
            box-shadow: 0px 0px 13px -7px #ffffff;
            background-color: rgb(82 192 255 / 15%);
        }

        .woosh-intro h1, .woosh-intro p {
            color: #fff
        }

    .woosh-btn {
        display: inline-block;
        padding: 10px 20px;
        background-color: #0070f3;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        margin-top: 10px;
    }

        .woosh-btn:hover {
            background-color: #005bb5;
        }

    section {
        padding: 30px !important;
    }
</style>
