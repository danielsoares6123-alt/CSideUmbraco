<style>
    .toggle-card {
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .toggle-card.active {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }

    .box-page {
    color: #000;
    background: #c3e2f8;
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    box-shadow: inset 0 0 16px rgb(197 250 251 / 61%), -3px 0 13px rgb(169 242 255 / 32%);
    transform: scale(1.02);
    transition: all 0.5s ease;
    opacity: 1;
    padding: 20px;
    height: 88%;
    border-radius: 20px;
    position: absolute;
    width: 95%;
    }

    .box-slide-icon {
        float: right;
        margin-top: -48px;
        height: 35px;
        font-size: 24px;
        transform: translateY(20px);
        transition: opacity 0.5s ease, transform 0.5s ease;
        pointer-events: none;
    }
</style>

<script>
    document.querySelectorAll('.toggle-card').forEach(function(card){
        card.addEventListener('click', function(){
            const isActive = card.classList.contains('active');

            // Fecha todos
            document.querySelectorAll('.toggle-card').forEach(function(c){
                c.classList.remove('active');
            });

            // Ativa o clicado
            if(!isActive){
                card.classList.add('active');
            }
        });
    });
</script>


<style>

    section {
        padding: 40px 0;
        border-bottom: 1px solid #eee;
    }

    /* Títulos com caixas arredondadas */
    .title-box {
        display: inline-block;
        font-weight: 300;
        background-color: #c3e2f8;
        padding: 10px 20px;
        border-radius: 50px; 
        margin-bottom: 10px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .title-box:hover {
        background-color: #a8d4f0;
    }

    .arrow {
        font-size: 18px;
        margin-left: 5px;
        transition: transform 0.3s;
    }

    /* Conteúdo escondido com slide toggle */
    .faq-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
        margin-top: 0;
    }

    .faq-content.active {
        max-height: 1000px; /* valor grande suficiente para o conteúdo */
        margin-top: 10px;
    }

    .faq-toggle.active .arrow {
        transform: rotate(180deg);
    }

.woosh-intro {
    padding-top: 220px !important;
    padding-bottom: 150px !important;
    margin-bottom: 16px;
    background: 
        linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)), 
        url(/images/DSCF5864.jpg) center/cover no-repeat;
}


.woosh-intro .container {
    backdrop-filter: blur(23px);
    padding: 72px 50px;
    border-radius: 20px;
    box-shadow: 0px 0px 13px -7px #ffffff;
    background-color: rgb(82 192 255 / 15%);
}

.woosh-intro h1, .woosh-intro p {
    color: #fff
}

    .woosh-btn {
        display: inline-block;
        padding: 10px 20px;
        background-color: #0070f3;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        margin-top: 10px;
    }

    .woosh-btn:hover {
        background-color: #005bb5;
    }

    section {
        padding: 30px !important;
    }
</style>

<script>
    document.querySelectorAll('.faq-toggle').forEach(function(title) {
        title.addEventListener('click', function() {
            const content = title.nextElementSibling;

            const isActive = content.classList.contains('active');

            // Fecha todos os conteúdos
            document.querySelectorAll('.faq-content').forEach(function(c){
                c.classList.remove('active');
            });
            document.querySelectorAll('.faq-toggle').forEach(function(t){
                t.classList.remove('active');
            });

            // Se não estava ativo, abre só o clicado
            if (!isActive) {
                content.classList.add('active');
                title.classList.add('active');
            }
        });
    });
</script>
