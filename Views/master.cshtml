</svg>

    </button>

    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                        const navbar = document.querySelector(".navbar");
                const links = navbar.querySelectorAll(".nav-link"); // todos os links dentro da navbar
                const brandImages = navbar.querySelectorAll(".navbar-brand img"); // corrige o seletor

               window.addEventListener("scroll", () => {
            if (window.scrollY > 50) {
                // fundo semi-transparente com blur
                navbar.style.backgroundColor = "rgba(247, 247, 247, 0.6)";
                navbar.style.backdropFilter = "blur(10px)";

                // ícones/links
                brandImages.forEach(img => img.style.setProperty("filter", "invert(0)", "important"));
                links.forEach(link => link.style.setProperty("color", "#000", "important"));
            } else {
                // transparente total sem blur
                navbar.style.backgroundColor = "rgba(255, 255, 255, 0)";
                navbar.style.backdropFilter = "none"; // remove o blur
                brandImages.forEach(img => img.style.removeProperty("filter"));
                links.forEach(link => link.style.removeProperty("color"));
            }
        });


                  const scrollBtn = document.getElementById('scrollTopBtn');

                  // Mostrar/esconder botão conforme scroll
                  window.addEventListener('scroll', () => {
                    if (window.scrollY > 300) {
                      scrollBtn.style.display = 'block';
                    } else {
                      scrollBtn.style.display = 'none';
                    }
                  });

                  // Scroll suave ao topo
                  scrollBtn.addEventListener('click', () => {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                  });


                });

    </script>

    <!-- Overlay e faixa de consentimento -->
    <div id="privacy-overlay">
        <div id="privacy-banner">
            <p>Este site utiliza cookies para otimizar a sua experiência de navegação. Aceita a utilização de cookies?</p>
            <div>
                <button class="accept" id="btn-aceitar" onclick="aceitarCookies();">Aceitar</button>
                <button class="reject" id="btn-recusar" onclick="recusarCookies();">Recusar</button>
            </div>
        </div>
    </div>


    <script>
        function aceitarCookies() {
          gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted',
            'functionality_storage': 'granted',
            'personalization_storage': 'granted'
          });
          document.getElementById("privacy-overlay").style.display = "none";
          document.getElementById("privacy-banner").style.display = "none";
          localStorage.setItem("cookiesConsent", "accepted");
        }

        function recusarCookies() {
          gtag('consent', 'update', {
            'ad_storage': 'denied',
            'analytics_storage': 'denied',
            'functionality_storage': 'denied',
            'personalization_storage': 'denied'
          });
          document.getElementById("privacy-overlay").style.display = "none";
          document.getElementById("privacy-banner").style.display = "none";

          localStorage.setItem("cookiesConsent", "denied");
        }

        // Mostrar a faixa só se o utilizador ainda não decidiu
        window.onload = function() {
          const consent = localStorage.getItem("cookiesConsent");

          if(consent != null) {
          if (consent === "accepted" || consent === "denied") {
            document.getElementById("privacy-overlay").style.display = "none";
            document.getElementById("privacy-banner").style.display = "none";
          }
          } else {
            document.getElementById("privacy-overlay").style.display = "flex";
            document.getElementById("privacy-banner").style.display = "flex";
          }

        };
    </script>

    <script src="~/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WT5XSKC"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            crossorigin=""></script>

    <!-- javascript libraries -->
    <script type="text/javascript" src="~/js/jquery.js"></script>
    <script type="text/javascript" src="~/js/vendors.min.js"></script>
    @if (ViewBag.NoMainJs != true)
    {
        <script type="text/javascript" src="~/js/main.js"></script>
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
</body>
</html>
