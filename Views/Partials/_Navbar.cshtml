@using Umbraco.Cms.Core.Models
@model IPublishedContent

@{
    List<IPublishedContent> menuOptions = Model.HasValue("menu") ? Model.Value<IEnumerable<IPublishedContent>>("menu").ToList() : new List<IPublishedContent>();
}

<nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
        <!-- Logotipo à esquerda -->
        <a class="navbar-brand" href="/">
            <img src="/images/logo.svg" alt="Logotipo" style="height:40px;" />
        </a>

        <button class="navbar-toggler" type="button" id="menuToggleBtn" aria-expanded="false" aria-label="Alternar navegação">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Opções à direita -->
        <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
            <ul class="navbar-nav">
                @foreach (var option in menuOptions)
                {
                    // Apenas o <li> recebe highlight se for "Particulares"
                    var liClass = option.Name == "Particulares" ? "nav-item highlight" : "nav-item";

                    // Verifica se existe pelo menos 1 filho do tipo "page"
                    var hasChildren = option.Children() != null && option.Children().Any(c => c.IsDocumentType("page"));

                    @if (hasChildren)
                    {
                        <li class="@liClass dropdown">
                            <a class="nav-link" href="@option.Url()" id="navbarDropdown_@option.Id">
                                @option.Name
                                <img onclick="window.location.href='@option.Url()'" src="/images/circulo_arrow_Woosh.svg" class="box-slide-icon" data-no-retina="">
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown_@option.Id">
                                @foreach (var child in option.Children().Where(c => c.IsDocumentType("page")))
                                {
                                    <li>
                                        <a class="dropdown-item" href="@child.Url()">@child.Name</a>
                                        <img src="/images/circulo_arrow_Woosh.svg" class="icon-accordion d-none" data-no-retina="">
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    else
                    {
                        <li class="@liClass">
                            <a class="nav-link" href="@option.Url()">@option.Name</a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</nav>


            <style>
    .navbar-nav .nav-item {
        position: relative;
        overflow: hidden; /* garante que a animação da caixa não exceda o item */
    }

    .navbar-nav .nav-link {
        position: relative;
        z-index: 1; /* fica acima da caixa de fundo */
        color: #000;
        padding: 0.5rem 1rem;
        transition: color 0.3s ease;
    }

    .navbar-nav .nav-item::before {
        content: "";
        position: absolute;
        left: 0%;
        top: 0;
        transform: translateX(0%);
        width: 0;
        height: 100%;
        z-index: 0;
        border-radius: 8px;
        transition: width 0.3s ease;
    }

    .navbar-nav .nav-item:hover::before {
        width: 100%; /* cobre toda a largura do item */
    }

    .navbar-nav .nav-item:hover .nav-link {
        color: #000; /* opcional: muda cor do texto no hover */
    }

            </style>