@using Umbraco.Cms.Core.Models
@model IPublishedContent

@{
    List<Link> menuOptions = Model.HasValue("menu") ? Model.Value<IEnumerable<Link>>("menu").ToList() : new List<Link>();
}

<nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
        <!-- Logotipo à esquerda -->
        <a class="navbar-brand" href="/">
            <img src="/images/logo.svg" alt="Logotipo" style="height:40px;" />
        </a>

        <!-- Botão para mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="Alternar navegação">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Opções à direita -->
        <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
            <ul class="navbar-nav">
                @foreach (var option in menuOptions)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="@option.Url">@option.Name</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

            <style>
    .navbar-nav .nav-item {
        position: relative;
        overflow: hidden; /* garante que a animação da caixa não exceda o item */
    }

    .navbar-nav .nav-link {
        position: relative;
        z-index: 1; /* fica acima da caixa de fundo */
        color: #000;
        padding: 0.5rem 1rem;
        transition: color 0.3s ease;
    }

    .navbar-nav .nav-item::before {
        content: "";
        position: absolute;
        left: 0%;
        top: 0;
        transform: translateX(0%);
        width: 0;
        height: 100%;
        background-color: rgba(67, 194, 255, 0.2); /* cor da caixa atrás do texto */
        z-index: 0;
        backdrop-filter: blur(7px);
        border-radius: 8px;
        transition: width 0.3s ease;
    }

    .navbar-nav .nav-item:hover::before {
        width: 100%; /* cobre toda a largura do item */
    }

    .navbar-nav .nav-item:hover .nav-link {
        color: #000; /* opcional: muda cor do texto no hover */
    }

            </style>