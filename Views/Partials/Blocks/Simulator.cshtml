@inject Umbraco.Cms.Web.Common.UmbracoHelper Umbraco

<div id="simulator">
    <div class="box">
        <div class="simulator-phaser">
            <div class="phase done" data-number="0"></div>
            <div class="phase" data-number="1"></div>
            <div class="phase" data-number="2"></div>
        </div>
        <img src="/images/circulo_arrow_Woosh.svg" class="simulator-back" data-no-retina="">
        <h6 class="text-center text-black mt-3 simulator-title">
            @Umbraco.GetDictionaryValue("Simulador.ProdutoEQuantidade")</h6>
        <!-- FASE 1: CARACTERISTICAS DE PRODUTO -->
        <div class="row simulator-phase simulator-phase-one gap-5" data-phase="1">
            <div class="col flex flex-col items-center">
                <img src="/images/icons/sofa.svg" alt="Sofá" class="w-16 h-16" />
                <span data-name="Sofá">@Umbraco.GetDictionaryValue("Simulador.Sofa")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
            <div class="col flex flex-col items-center">
                <img src="/images/icons/tapete.svg" alt="Tapete" class="w-16 h-16" />
                <span data-name="Tapete">@Umbraco.GetDictionaryValue("Simulador.Tapete")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
            <div class="col flex flex-col items-center">
                <img src="/images/icons/puff.svg" alt="Puff" class="w-16 h-16" />
                <span data-name="Puff">@Umbraco.GetDictionaryValue("Simulador.Puff")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
            <div class="col flex flex-col items-center">
                <img src="/images/icons/cadeira.svg" alt="Cadeira" class="w-16 h-16" />
                <span data-name="Cadeira">@Umbraco.GetDictionaryValue("Simulador.Cadeira")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
            <div class="col flex flex-col items-center">
                <img src="/images/icons/cabeceira.svg" alt="Cabeceira" class="w-16 h-16" />
                <span data-name="Cabeceira">@Umbraco.GetDictionaryValue("Simulador.Cabeceira")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
            <div class="col flex flex-col items-center">
                <img src="/images/icons/colchao.svg" alt="Colchão" class="w-16 h-16" />
                <span data-name="Colchão">@Umbraco.GetDictionaryValue("Simulador.Colchao")</span>

                <!-- Contador -->
                <div class="flex items-center gap-3 mt-2 simulator-counter">
                    <button class="counter-btn decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                    <span class="counter-text text-lg font-bold">0</span>
                    <button class="counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                </div>
            </div>
        </div>
        <!-- [FIM] FASE 1: CARACTERISTICAS DE PRODUTO -->
        <!-- FASE 2: CARACTERISTICAS DE PRODUTO -->
        <div class="row simulator-phase simulator-phase-two gap-x-5 m-0 d-none" data-phase="2">

            <!-- ITEMS SELECIONADOS NA PRIMEIRA FASE SURGIRÃO AQUI -->
            <div class="col-lg-10 col-8 items"></div>

            <div class="col-lg-2 col-4 bg-lightgray add-more-products d-flex flex-column align-items-center justify-content-center text-center">
                <button class="add-more-products-btn counter-btn increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                <span style="width: 131px;display: block;word-break: break-word;line-height: 117%;">@Umbraco.GetDictionaryValue("Simulador.AdicionarProdutos")</span>
            </div>
            <div class="item-properties">
                <div class="row properties">
                    <div class="col-lg-3 col-12">
                        <span class="property-text"><span class="property-number">01.</span> @Umbraco.GetDictionaryValue("Simulador.Caracteristicas")</span>
                    </div>
                    <div class="col-lg-9 col-12 text-left">

                        <!-- ATRIBUTO SOFÁ -->
                        <div class="attribute d-none" data-type="1">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box text-center">
                                        <img src="/images/icons/sofa.svg" alt="Sofá" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.SofaLugares")</p>
                                        <!-- Contador -->
                                        <div class="flex items-center gap-3 simulator-counter justify-center">
                                            <button class="counter-btn counter-inner decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                                            <span class="counter-text text-lg font-bold">0</span>
                                            <button class="counter-btn counter-inner increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                                        </div>

                                        <!-- Aqui será inserido o switch dinamicamente -->
                                        <div class="chaise-switch-container mt-5 pt-5"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- FIM DO ATRIBUTO SOFÁ -->
                        <!-- ATRIBUTO TAPETE -->
                        <div class="attribute d-none" data-type="2">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/redondo.svg" alt="Redondo" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Tapete.Redondo")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-open-details="1" data-name="Redondo" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/quadrado.svg" alt="Quadrado" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Tapete.Quadrado")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-open-details="2" data-name="Quadrado" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/retangulo.svg" alt="Retângulo" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Tapete.Retangulo")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-open-details="3" data-name="Retângulo" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/outro.svg" alt="Outro" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Tapete.Outro")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-open-details="4" data-name="Outro" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIM DO ATRIBUTO TAPETE -->
                        <!-- ATRIBUTO PUFF -->
                        <div class="attribute d-none" data-type="3">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/puff.svg" alt="Puff" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.PuffLugares")</p>
                                        <!-- Contador -->
                                        <div class="flex items-center gap-3 simulator-counter">
                                            <button class="counter-btn counter-inner decrement bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">-</button>
                                            <span class="counter-text counter-inner-text text-lg font-bold">0</span>
                                            <button class="counter-btn counter-inner increment bg-gray-300 text-gray-700 px-3 py-1 rounded-lg font-bold hover:bg-gray-400">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIM DO ATRIBUTO PUFF -->
                        <!-- ATRIBUTO CADEIRA -->
                        <div class="attribute d-none" data-type="4">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/cadeirao.svg" alt="Cadeirão" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Cadeira.Cadeirao")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Cadeirão" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/cadeira.svg" alt="Cadeira" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Cadeira.AssentoCostas")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Assento/costas" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/acento.svg" alt="Assento" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Cadeira.SoAssento")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Só assento" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/chaiselong.svg" alt="Chaise Long" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Cadeira.ChaiseLong")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Chaise Long" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIM DO ATRIBUTO CADEIRA -->
                        <!-- ATRIBUTO CABECEIRA -->
                        <div class="attribute d-none" data-type="5">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box text-center">
                                        <img src="/images/icons/cabeceira.svg" alt="Cabeceira" class="mx-auto" />
                                        <p class="mt-2">@Umbraco.GetDictionaryValue("Simulador.Cabeceira.Cama")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Cabeceira cama" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIM DO ATRIBUTO CABECEIRA -->
                        <!-- ATRIBUTO COLCHÃO -->
                        <div class="attribute d-none" data-type="6">
                            <div class="row">
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/bebe.svg" alt="Bebé" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Colchao.Bebe")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Bebé" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/colchaoIndividual.svg" alt="Colchão Individual" />
                                        <p>@Umbraco.GetDictionaryValue("Simulador.Colchao.Individual")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Individual" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="col-lg-2 col-12 attribute-col">
                                    <div class="attribute-box">
                                        <img src="/images/icons/colchao.svg" alt="Colchão" />
                                        <p>@Umbraco.GetDictionaryValue("Simualdor.Colchao.Casal")</p>
                                        <!-- Switch toggle -->
                                        <label class="switch mt-3 cursor-pointer">
                                            <input type="checkbox" class="hidden" data-name="Casal" />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIM DO ATRIBUTO COLCHÃO -->

                        <div class="switch-details d-none" data-id="1">
                            <div class="d-flex gap-3">
                                <a href="#">
                                    <img src="/images/circulo_arrow_Woosh.svg" class="box-slide-icon" data-no-retina="">
                                </a>
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Formato"): @Umbraco.GetDictionaryValue("Simulador.Tapete.Redondo")</div>
                            </div>
                            <div class="row p-0 pt-1">
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Medidas")</div>
                            </div>
                            <div class="row">
                                <div class="d-flex p-0 measurements">
                                    <div>
                                        <img src="/images/icons/redondo.svg" alt="Redondo" />
                                    </div>
                                    <div class="d-flex">
                                        <span>@Umbraco.GetDictionaryValue("Simulador.Tapete.Diametro")</span>
                                        <input type="text" class="format-input" id="redondo" name="redondo" />
                                        <span>= <span id="redondoResultados"></span></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="switch-details d-none" data-id="2">
                            <div class="d-flex gap-3">
                                <a href="#">
                                    <img src="/images/circulo_arrow_Woosh.svg" class="box-slide-icon" data-no-retina="">
                                </a>
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Formato"): @Umbraco.GetDictionaryValue("Simulador.Tapete.Quadrado")</div>
                            </div>
                            <div class="row p-0 pt-1">
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Medidas")</div>
                            </div>
                            <div class="row">
                                <div class="d-flex p-0 measurements">
                                    <div>
                                        <img src="/images/icons/quadrado.svg" alt="Quadrado" />
                                    </div>
                                    <div class="d-flex">
                                        <span>x</span>
                                        <input type="text" class="format-input" id="quadradoX" name="quadradoX" />
                                        <span>y</span>
                                        <input type="text" class="format-input" id="quadradoY" name="quadradoY" />
                                        <span>= <span id="quadradoResultados"></span></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="switch-details d-none" data-id="3">
                            <div class="d-flex gap-3">
                                <a href="#">
                                    <img src="/images/circulo_arrow_Woosh.svg" class="box-slide-icon" data-no-retina="">
                                </a>
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Formato"): @Umbraco.GetDictionaryValue("Simulador.Tapete.Retangulo")</div>
                            </div>
                            <div class="row p-0 pt-1">
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Medidas")</div>
                            </div>
                            <div class="row">
                                <div class="d-flex p-0 measurements">
                                    <div>
                                        <img src="/images/icons/retangulo.svg" alt="Retângulo" />
                                    </div>
                                    <div class="d-flex">
                                        <span>x</span>
                                        <input type="text" class="format-input" id="retanguloX" name="retanguloX" />
                                        <span>y</span>
                                        <input type="text" class="format-input" id="retanguloY" name="retanguloY" />
                                        <span>= <span id="retanguloResultados"></span></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="switch-details d-none" data-id="4">
                            <div class="d-flex gap-3">
                                <a href="#">
                                    <img src="/images/circulo_arrow_Woosh.svg" class="box-slide-icon" data-no-retina="">
                                </a>
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Formato"): @Umbraco.GetDictionaryValue("Simulador.Tapete.Outro")</div>
                            </div>
                            <div class="row p-0 pt-1">
                                <div>@Umbraco.GetDictionaryValue("Simulador.Tapete.Medidas")</div>
                            </div>
                            <div class="row">
                                <div class="d-flex p-0 measurements">
                                    <div>
                                        <img src="/images/icons/outro.svg" alt="Outro" />
                                    </div>
                                    <div class="d-flex">
                                        <span>x</span>
                                        <input type="text" class="format-input" id="outroX" name="OutroX" />
                                        <span>y</span>
                                        <input type="text" class="format-input" id="outroY" name="OutroY" />
                                        <span>= <span id="outrosResultados"></span></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row pt-4 pb-4 mb-0 finish">
                    <div class="col-3">
                        <span class="property-text"><span class="property-number">02.</span> @Umbraco.GetDictionaryValue("Simulador.Acabamento")</span>
                    </div>
                    <div class="col-9 text-left">
                        <div class="flex">
                            <button class="private-button finish-button" data-value="Tecido">@Umbraco.GetDictionaryValue("Simulador.Acabamento.Tecido")</button>
                            <button class="private-button finish-button" data-value="Pele">@Umbraco.GetDictionaryValue("Simulador.Acabamento.Pele")</button>
                        </div>
                    </div>
                </div>
                <div class="row pt-4 pb-4 service">
                    <div class="col-3 text-left">
                        <span class="property-text"><span class="property-number">03.</span> @Umbraco.GetDictionaryValue("Simulador.Serviço")</span>
                    </div>
                    <div class="col-9 text-left">
                        <div class="flex">
                            <button class="private-button service-s-button" data-value="Limpeza">@Umbraco.GetDictionaryValue("Simulador.Serviço.Limpeza")</button>
                            <button class="private-button service-s-button" data-value="Impermeabilização">@Umbraco.GetDictionaryValue("Simulador.Serviço.Impermeabilização")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [FIM] FASE 2: CARACTERISTICAS DE PRODUTO -->
        <!-- FASE 3: PREÇÁRIO DOS PRODUTOS SELECIONADOS -->
        <div class="row simulator-phase simulator-phase-two gap-x-5 m-0 d-none" data-phase="3">
            <div class="selected-products-pricing"></div>
        </div>

    </div>
    <a href="#" class="ws-button simulator-button-next">
        @Umbraco.GetDictionaryValue("Simulador.Seguinte")
        <img src="/images/circulo_arrow_Woosh.svg" class="icon-accordion" data-no-retina="">
    </a>
    <a href="#" class="ws-button submit-button" style="display: none;">
        @Umbraco.GetDictionaryValue("Simulador.Finalizar")
        <img src="/images/circulo_arrow_Woosh.svg" class="icon-accordion" data-no-retina="">
    </a>
</div>


<style>
    .woosh-intro {
        display: none;
    }

    div:where(.swal2-container).swal2-center > .swal2-popup {
        border-radius: 43px;
        width: 50%;
    }

    div:where(.swal2-container) div:where(.swal2-html-container) input {
        margin: 20px 0px;
        font-size: 20px !important;
    }

    div:where(.swal2-container) div:where(.swal2-validation-message) {
        margin: 0 auto !important;
        border-radius: 20px;
        background: #f1f1f1;
    }
</style>

@Html.AntiForgeryToken()
<script src="/js/pages/private.js"></script>
