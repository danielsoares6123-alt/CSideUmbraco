@model IPublishedContent

@{
    var slides = Model.Value<IPublishedContent>("parameter");
}

<section class="cside-section cside-hero" style="background: linear-gradient(135deg, #1f1b24 0%, #2d2835 50%, #1a1720 100%);">
    <div class="cside-hero-wrapper">
        <!-- Left Content -->
        <div class="cside-hero-content">
            <span class="cside-hero-badge">c|side Energy Solutions</span>
            @if (slides != null && slides.Children.Any())
            {
                var firstSlide = slides.Children.FirstOrDefault();
                <h1 class="cside-hero-title">@Html.Raw(firstSlide.Name.Replace("-", "&#8209;"))</h1>
            }
            else
            {
                <h1 class="cside-hero-title">Renováveis<br><span class="accent">&amp; Baterias</span></h1>
            }
            <p class="cside-hero-subtitle">Monitorize e optimize o consumo energético da sua casa com tecnologia de ponta</p>
            
            <div class="cside-hero-cta">
                <a href="/pt/solucoes/renovaveis-baterias/" class="cside-btn cside-btn-primary">
                    <i class="fas fa-bolt"></i> Descobrir Soluções
                </a>
                <a href="/pt/contactos/" class="cside-btn cside-btn-outline">
                    Falar Connosco
                </a>
            </div>
            
            <!-- Stats -->
            <div class="cside-hero-stats">
                <div class="stat-item">
                    <span class="stat-value">30%</span>
                    <span class="stat-label">Poupança Média</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">24/7</span>
                    <span class="stat-label">Monitorização</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">100+</span>
                    <span class="stat-label">Instalações</span>
                </div>
            </div>
        </div>
        
        <!-- Right Image -->
        <div class="cside-hero-image">
            <img src="/images/cside-hero-energy.png" alt="Nano Banana Pro - Smart Energy Monitor" class="hero-device">
            <div class="hero-glow"></div>
        </div>
    </div>
    
    <!-- Solution Buttons Menu -->
    <nav class="cside-solutions-menu">
        <a href="/pt/solucoes/eletricidade-gas-agua/" class="cside-solution-btn">
            <i class="fas fa-plug"></i> Eletricidade, Gás & Água
        </a>
        <a href="/pt/solucoes/renovaveis-baterias/" class="cside-solution-btn active">
            <i class="fas fa-solar-panel"></i> Renováveis & Baterias
        </a>
        <a href="/pt/solucoes/servicos-avancados-de-energia/" class="cside-solution-btn">
            <i class="fas fa-chart-line"></i> Serviços Avançados
        </a>
        <a href="/pt/solucoes/casa-inteligente/" class="cside-solution-btn">
            <i class="fas fa-home"></i> Casa Inteligente
        </a>
    </nav>
</section>

<style>
    .cside-hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 120px 0 60px;
        position: relative;
        overflow: hidden;
    }
    
    .cside-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(ellipse at 20% 50%, rgba(255, 107, 53, 0.15) 0%, transparent 50%),
            radial-gradient(ellipse at 80% 20%, rgba(255, 140, 66, 0.1) 0%, transparent 40%);
        pointer-events: none;
    }
    
    .cside-hero-wrapper {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 50px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
        flex: 1;
    }
    
    .cside-hero-badge {
        display: inline-block;
        background: rgba(255, 107, 53, 0.15);
        color: #FF6B35;
        padding: 8px 20px;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(255, 107, 53, 0.3);
    }
    
    .cside-hero-title {
        font-size: 4rem;
        font-weight: 300;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        color: #fff;
    }
    
    .cside-hero-title .accent {
        color: #FF6B35;
        font-weight: 600;
    }
    
    .cside-hero-subtitle {
        font-size: 1.25rem;
        color: rgba(255,255,255,0.7);
        margin-bottom: 2.5rem;
        max-width: 500px;
        line-height: 1.6;
    }
    
    .cside-hero-cta {
        display: flex;
        gap: 1rem;
        margin-bottom: 3rem;
    }
    
    .cside-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    
    .cside-btn-primary {
        background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
        color: #fff;
    }
    
    .cside-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(255, 107, 53, 0.3);
    }
    
    .cside-btn-outline {
        background: transparent;
        color: #fff;
        border: 2px solid rgba(255,255,255,0.3);
    }
    
    .cside-btn-outline:hover {
        background: rgba(255,255,255,0.1);
        border-color: #FF6B35;
        color: #FF6B35;
    }
    
    .cside-hero-stats {
        display: flex;
        gap: 3rem;
    }
    
    .stat-item {
        text-align: center;
    }
    
    .stat-value {
        display: block;
        font-size: 2.5rem;
        font-weight: 600;
        color: #FF6B35;
        line-height: 1;
    }
    
    .stat-label {
        display: block;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
        margin-top: 0.5rem;
    }
    
    .cside-hero-image {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .hero-device {
        max-width: 100%;
        height: auto;
        border-radius: 20px;
        box-shadow: 0 50px 100px rgba(0,0,0,0.5);
        animation: float 6s ease-in-out infinite;
    }
    
    .hero-glow {
        position: absolute;
        width: 80%;
        height: 80%;
        background: radial-gradient(ellipse, rgba(255, 107, 53, 0.3) 0%, transparent 70%);
        filter: blur(60px);
        z-index: -1;
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    
    .cside-solutions-menu {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.5rem;
        background: rgba(10, 22, 40, 0.8);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255, 107, 53, 0.2);
    }
    
    .cside-solution-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }
    
    .cside-solution-btn:hover,
    .cside-solution-btn.active {
        background: rgba(255, 107, 53, 0.15);
        color: #FF6B35;
        border-color: rgba(255, 107, 53, 0.3);
    }
    
    .cside-solution-btn i {
        font-size: 1rem;
    }
    
    @@media (max-width: 1200px) {
        .cside-hero-wrapper {
            grid-template-columns: 1fr;
            text-align: center;
        }
        
        .cside-hero-subtitle {
            margin-left: auto;
            margin-right: auto;
        }
        
        .cside-hero-cta {
            justify-content: center;
        }
        
        .cside-hero-stats {
            justify-content: center;
        }
        
        .cside-hero-image {
            order: -1;
            max-width: 500px;
            margin: 0 auto;
        }
    }
    
    @@media (max-width: 768px) {
        .cside-hero-title {
            font-size: 2.5rem;
        }
        
        .cside-solutions-menu {
            flex-wrap: wrap;
        }
        
        .cside-hero-stats {
            flex-wrap: wrap;
            gap: 1.5rem;
        }
    }
</style>
