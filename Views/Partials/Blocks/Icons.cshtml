@model IPublishedContent

@{
    IPublishedContent Boxes = Model.Value<IPublishedContent>("parameter").FirstOrDefault();
    List<IPublishedContent> ListBoxes = Boxes.Children().Where(x => x.IsDocumentType("box")).ToList();
}

<div class="row-icons">
    @foreach (var ListBox in ListBoxes)
    {
        string name = ListBox.Value("boxName").ToString();
        string image = ListBox.HasValue("boxImage") ? ListBox.Value<IPublishedContent>("boxImage").Url() : String.Empty
        string pageDestination = ListBox.HasValue("pageDestination") ? ListBox.Value<IPublishedContent>("pageDestination").Url() : String.Empty;

        <div class="col-icon">
            <div class="icon">
            <a href="@pageDestination">
                <img src="/images/circulo_Woosh.svg" alt="Círculo" />
                <img src="@image" alt="@name" />
            </a>
        </div>
        <a href="@pageDestination"><h3>@name</h3></a>
    </div>
    }
</div>

<style>
    .row-icons {
        display: flex;
        justify-content: center;
        gap: 40px; /* espaço entre colunas */
        text-align: center;
        flex-wrap: nowrap; /* força tudo na mesma linha */
        max-width: 1200px; /* opcional: limita largura total da linha */
        margin: -20px auto;
    }

    .col-icon {
        flex: 1 1 200px; /* cada coluna cresce e mantém mínimo de 200px */
        padding: 20px;
    }

        .col-icon h3 {
            font-size: 0.9rem !important;
            font-weight: 600;
        }

        .col-icon a {
            text-decoration: none;
            color: #000;
        }

        .col-icon:hover a {
            font-weight: bold;
        }

    .icon {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 15px auto;
    }

        .icon img {
            transition: filter 0.5s ease-out;
        }

            .icon img:first-child {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }

            .icon img:last-child {
                position: relative;
                width: 60%;
                height: 60%;
                z-index: 1;
                margin-top: 20px;
                filter: brightness(0) saturate(100%) invert(76%) sepia(12%) saturate(9%) hue-rotate(336deg) brightness(78%) contrast(81%);
            }

            .icon img[alt="Círculo"] {
                filter: invert(69%) sepia(53%) saturate(600%) hue-rotate(180deg) brightness(105%) contrast(90%);
                transition: transform 0.6s ease; /* animação suave */
                transform-origin: center; /* gira em torno do centro */
                opacity: 0.5;
            }

        .icon:hover img[alt="Círculo"] {
            transform: rotate(180deg);
        }

        .icon:hover img:not([alt="Círculo"]) {
            filter: blur(1px);
        }
</style>
