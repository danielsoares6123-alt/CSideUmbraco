@model IPublishedContent

@{
    var laundries = Model.Value<IPublishedContent>("parameter");
    List<IPublishedContent> listLaundries = laundries.Children().Where(x => x.IsDocumentType("laundry")).ToList();
}

<link href="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.js"></script>
<script src="https://unpkg.com/three@0.126.0/build/three.min.js"></script>
<script src="https://unpkg.com/three@0.126.0/examples/js/loaders/GLTFLoader.js"></script>

<div class="map-header">
    <button class="ws-button ws-button-full w-100 mt-3 map-toggle" type="button">
        <img src="/images/icons/menu.svg" style="height: 50px; margin-left: unset !important; margin-top: -12px; filter: invert(1);" />
        <img class="leftArrow" src="/images/icons/left-arrow.svg" />
    </button>
    <img role="link" onclick="window.location.href = '/'" class="map-logo" src="/images/logo.svg" />
    <div class="map-menu">
        <p class="mb-0">Pesquisar lavandaria (Código postal ou Rua)</p>
        <input class="ps-0 border-radius-0px bg-transparent form-control required"
               id="laundrySearch"
               type="text"
               name="laundrySearch"
               placeholder="Ex: 1234-567 ou Rua da Liberdade">
        <button class="mt-3 ws-button ws-button-full w-100" type="submit">
            <img class="map-search-icon" src="/images/icons/map.svg" />
            Filtrar mapa
        </button>
    </div>
</div>

<div id="mapLaundries" style="height: 100vh; width: 100%; position: relative;"></div>
<div id="missingCount" style="position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.5); color: white; padding: 8px 12px; border-radius: 4px; font-family: sans-serif; z-index: 10;"></div>

<script>
        const laundries = [
        @foreach (var laundry in listLaundries)
        {
                    var lat = laundry.Value<double?>("laundryLat") ?? 0;
                    var lon = laundry.Value<double?>("laundryLon") ?? 0;
                    var name = laundry.Value("laundryName")?.ToString().Replace("\"", "\\\"") ?? "";
                    var address = $"{laundry.Value("laundryAddress")}, {laundry.Value("laundryCity")}".Replace("\"", "\\\"");

                    <text>@Html.Raw($"{{ lat: {lat}, lon: {lon}, name: \"{name}\", address: \"{address}\" }}{(laundry != listLaundries.Last() ? "," : "")}")</text>
           }
        ];
</script>
<script type="text/javascript" src="/js/pages/map.js"></script>


<link rel="stylesheet" href="/css/pages/map.css" />