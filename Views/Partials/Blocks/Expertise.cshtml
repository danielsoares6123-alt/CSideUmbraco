<div class="container">
    <h1>Expertise</h1>
</div>
<div class="expertise-container container p-0 mt-4">

    <div class="container-fluid">
        <div class="expertise-row">
            <div class="expertise-col">
                <div class="expertise-box">
                    <div class="overlay"></div>
                    <div class="box-content pt-5">
                        <!-- Import the component -->
                        <!--<model-viewer style="overflow: hidden;" alt="Higienização e Tratamentos" src="/3d/higienizacao.glb" shadow-intensity="0" camera-controls touch-action="pan-y" auto-rotate rotation-per-second="60deg"></model-viewer> -->                       <span class="slide-title">Higienização e Tratamentos</span>
                        <p class="slide-desc">
                            A nossa procura constante pela inovação e otimização da limpeza permitiu-nos desenvolver novos métodos. Veja abaixo o resultado da modernização dos serviços de higienização e acabamentos.
                        </p>
                    </div>
                </div>
            </div>
            <div class="expertise-col">
                <div class="expertise-box">
                    <div class="overlay"></div>
                    <div class="box-content pt-5">
                        <span class="slide-title">Impermeabilização</span>
                        <p class="slide-desc">
                            Impermeabilizar as suas peças é uma excelente maneira de prolongar a sua longevidade e durabilidade. A Woosh disponibiliza este serviço adaptado a tapetes, sofás, cadeiras e vestuário.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="expertise-row">
            <div class="expertise-col">
                <div class="expertise-box">
                    <div class="overlay"></div>
                    <div class="box-content pt-5">
                        <span class="slide-title">Limpeza especializada</span>
                        <p class="slide-desc">
                            A Woosh garante limpeza profunda de vestuário e têxteis-lar com métodos avançados. Pela App pode acompanhar artigos, encomendar e gerir a conta. Descubra como a Woosh ajuda o seu negócio a crescer.                        </p>
                    </div>
                </div>
            </div>
            <div class="expertise-col"> 
                <div class="expertise-box">
                    <div class="overlay"></div>
                    <div class="box-content pt-5">
                        <span class="slide-title">Retardante de fogo</span>
                        <p class="slide-desc">
                            Este produto cria um acabamento retardante de chama, não permanente, nos tecidos feitos de fibras de celulose regenerativas, lã, poliacrilonitrila, poliéster e tecidos feitos de fibras sintéticas e naturais.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .expertise-container {
        width: 90%;
        margin: auto;
        font-family: sans-serif;
    }

    .expertise-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

    .expertise-col {
        flex: 1;
        transition: all 0.4s ease;
    }

    .expertise-box {
        position: relative;
        background: rgba(255, 255, 255, 0.15); /* fundo semi-transparente */
        padding: 20px;
        height: 300px;
        border-radius: 60px;
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1); /* sombra suave */
        /* Glassmorphism */
        backdrop-filter: blur(15px); /* desfoque do fundo */
        -webkit-backdrop-filter: blur(15px); /* suporte Safari */
        border: 1px solid rgba(255, 255, 255, 0.25); /* borda translúcida */
        /*background-image: url('/images/DSCF5828.jpg');
        background-size: cover;*/
    }


        .expertise-box .overlay {
            border-radius: 60px;
        }


        .expertise-box:hover .overlay {
            background: linear-gradient(-45deg, rgba(255, 255, 255, 0.35) 0%, /* branco translúcido */ rgba(0, 123, 255, 0.25) 100% /* azul translúcido */ );
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            box-shadow: inset 0 0 16px rgb(197 250 251 / 61%), -3px 0 13px rgb(169 242 255 / 32%);
            transform: scale(1.02);
            filter: blur(3px);
            transition: all 0.5s ease;
            opacity: 1;
            height: 88%;
            position: absolute;
            width: 95%;
        }

        .expertise-box model-viewer {
            opacity: 1;
            width: 100%;
            overflow: hidden !important;
        }

        .expertise-box .slide-title {
            position: unset !important;
            font-size: 1.4rem;
            margin-bottom: 10px;
            transition: transform 0.4s ease, padding-top 0.4s ease;
            font-weight: 700;
            text-align: center;
            display: block;
            width: 100%;
            padding-top: 12%;
        }


        .expertise-box .box-content {
            position: absolute;
            z-index: 99999;
            top: 0px;
            left: 0px;
            width: 100%;
        }

        .expertise-box .slide-desc,
        .expertise-box .box-slide-icon {
            opacity: 0;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .expertise-box .box-slide-icon {
            position: absolute;
            bottom: 20px;
            right: 20px;
        }

        .expertise-box:hover .slide-desc {
            text-align: center;
            padding: 0px 70px;
        }

        .expertise-box:hover .box-slide-icon {
            bottom: 40px;
            right: 40px;
        }

        .expertise-box:hover .slide-title {
            padding-top: 5% !important;
        }

        .expertise-box:hover .slide-desc {
            opacity: 1;
        }
</style>

<script>
    const rows = document.querySelectorAll('.expertise-row');

    rows.forEach(row => {
        const cols = row.querySelectorAll('.expertise-col');

        cols.forEach(col => {
            const box = col.querySelector('.expertise-box');

            box.addEventListener('mouseenter', () => {
                // Expande só a coluna hover
                col.style.flex = '1.5';

                // Colunas à frente podem ser empurradas
                cols.forEach(c => {
                    if(c !== col) c.style.flex = '1';
                });
            });

            box.addEventListener('mouseleave', () => {
                // Volta todas ao tamanho normal
                cols.forEach(c => c.style.flex = '1');
            });
        });
    });
</script>
