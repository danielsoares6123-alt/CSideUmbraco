@using Umbraco.Cms.Core.Models
@model IPublishedContent

@{
    List<IPublishedContent> menuOptions = Model.HasValue("footerMenu") ? Model.Value<IEnumerable<IPublishedContent>>("footerMenu").ToList() : new List<IPublishedContent>();
    List<IPublishedContent> usefulInformation = Model.HasValue("usefulInformation") ? Model.Value<IEnumerable<IPublishedContent>>("usefulInformation").ToList() : new List<IPublishedContent>();
    List<string> socialNetworks = Model.HasValue("socialNetworks")
        ? Model.Value<IEnumerable<string>>("socialNetworks").ToList()
        : new List<string>();

    string email = Model.Value("email").ToString();
    string address = Model.Value("address").ToString();
    // Lê os números do campo e divide por vírgula, ponto e vírgula ou quebra de linha
    var phoneNumbersRaw = Model.HasValue("phoneNumbers") ? Model.Value<string>("phoneNumbers") : string.Empty;
    var splitedPhoneNumbers = phoneNumbersRaw
    .Split(new[] { ',', ';', '|', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
    .Select(n => n.Trim())
    .Where(n => !string.IsNullOrWhiteSpace(n))
    .ToList();


    var firstNumber = splitedPhoneNumbers.FirstOrDefault() ?? string.Empty;
    var lastNumber = splitedPhoneNumbers.LastOrDefault() ?? string.Empty;

    // Limpar espaços para o href
    string CleanNumber(string n) => n.Replace(" ", "").Replace("-", "");

    // Dicionário com ícones baseados no nome da rede
    var icons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "instagram", "/images/icons/instagram.svg" },
        { "facebook", "/images/icons/facebook.svg" },
        { "linkedin", "/images/icons/linkedin.svg" },
        { "twitter", "/images/icons/twitter.svg" },
        { "x.com", "/images/icons/twitter.svg" },
        { "youtube", "/images/icons/youtube.svg" },
        { "tiktok", "/images/icons/tiktok.svg" },
        { "whatsapp", "/images/icons/whatsapp.svg" }
    };

    // Função para detetar a rede pelo URL
    string DetectNetwork(string url)
    {
        foreach (var key in icons.Keys)
        {
            if (url.Contains(key, StringComparison.OrdinalIgnoreCase))
                return key;
        }
        return null;
    }
}

<!-- Footer -->
<footer class="woosh-footer">
    <div class="footer-container">

        <!-- Seção 1: About -->
        <div class="footer-section about pe-3">
            <img src="/images/logo.svg" alt="Logotipo" style="height: 40px;margin-bottom: 22px;">
            <p class="mt-4">
                Somos uma marca com mais de 30 anos de experiência no setor da limpeza profissional e especializada, garantindo qualidade, confiança e soluções personalizadas para cada cliente.
            </p>
        </div>

        <!-- Seção 2: Sobre a Woosh -->
        <div class="footer-section links">
            <h3>Sobre a Woosh</h3>
            <ul>
                @foreach (var menuOption in menuOptions)
                {
                    <li><a href="@menuOption.Url()">@menuOption.Name</a></li>
                }
            </ul>
        </div>

        <!-- Seção 3: Contato -->
        <div class="footer-section contact">
            <h3>Informação Útil</h3>
            <ul>
                @foreach (var information in usefulInformation)
                {
                    <li><a href="@information.Url()">@information.Name</a></li>
                }
            </ul>
            <p class="mt-4">
                <h3>Redes Sociais</h3>
                @if (socialNetworks.Any())
                {
                    <div class="social-icons">
                        @foreach (var link in socialNetworks)
                        {
                            var network = DetectNetwork(link);
                            var iconPath = network != null && icons.ContainsKey(network)
                            ? icons[network]
                            : "/images/icons/default.svg"; // Ícone genérico caso não detete

                            <a href="@link" target="_blank" rel="noopener noreferrer" aria-label="@network">
                                <img src="@iconPath" alt="@network" />
                            </a>
                        }
                    </div>
                }
            </p>
        </div>

        <div class="footer-section">
            <h3>Contacto</h3>
            <p>
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <a href="mailto:@email">@email</a>
                }
            </p>
            @Html.Raw(address)
        </div>

        <div class="logos-bar">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-12">
                        <p>&copy; 2025 Woosh Limpezas. Todos os direitos reservados.</p>
                    </div>
                    <div class="col-lg-6 col-12">
                        <img src="/media/nadgjno0/barra_logos-02-3.png" alt="PRR Plano de Recuperação e Resiliência" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mobile-logo-bar">
            <img src="/media/nadgjno0/barra_logos-02-3.png" alt="PRR Plano de Recuperação e Resiliência" />
        </div>
    </div>
</footer>
