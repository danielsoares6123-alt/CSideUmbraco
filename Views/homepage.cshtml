@using Umbraco.Cms.Web.Common.PublishedModels
@using Microsoft.AspNetCore.Http
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = "master.cshtml";

    var homeNode = Umbraco.AssignedContentItem;
    var httpContext = Context;
    var requestPath = httpContext.Request.Path.Value?.ToLower() ?? "";
    var defaultLanguage = "pt"; // <-- muda aqui para o alias da língua padrão

    // Podes definir aqui as línguas disponíveis no site
    var supportedLanguages = new[] { "pt", "en", "es", "fr" };

    // Verifica se o caminho começa com uma das línguas
    bool hasLang = supportedLanguages.Any(lang => requestPath.StartsWith($"/{lang}/") || requestPath.Equals($"/{lang}"));

    if (!hasLang)
    {
        var newUrl = $"/{defaultLanguage}{requestPath}";
        httpContext.Response.Redirect(newUrl, false);
        httpContext.Response.CompleteAsync().Wait();
        return;
    }

    IPublishedContent Blocks = homeNode.Children.Where(x => x.IsDocumentType("blocks")).FirstOrDefault();
}


<div class="home-children">
    @foreach (var bloco in Blocks.Children)
    {
        string content = bloco.Value<string>("content"); // Rich Text Editor
        string partialName = bloco.Value("partialName").ToString();
        var partialPath = $"Partials/Blocks/{partialName}";

        try
        {
            // Tenta renderizar o partial, mesmo que parameter seja null
            @await Html.PartialAsync(partialPath, bloco)
        }
        catch
        {
            // Se o partial não existir, renderiza Rich Text Editor
            if (!string.IsNullOrEmpty(content))
            {
                <div class="block-content">
                    @Html.Raw(content)
                </div>
            }
        }
    }

</div>
<div id="background-dots"></div>
<div class="woosh-app-footer">
    <div class="container pt-2 pb-2">
        <div class="row">
            <div class="col-lg-8 col-12 text-column">
                <span class="text-black">Faça o download do App Woosh e descubra ainda mais vantagens de ser um parceiro Woosh</span>
            </div>
            <div class="col-lg-2 col-12 app-column">
                <img src="/images/icons/AppStore.svg" alt="Apple Store Woosh App" />
            </div>
            <div class="col-lg-2 col-12 app-column">
                <img src="/images/icons/googlePlay.svg" alt="Google Play Woosh App" />
            </div>
        </div>
    </div>
</div>
<style>.shape-image-animation {z-index: -1;}</style>

<script type="text/javascript" src="/js/dots.js"></script>